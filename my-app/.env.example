# Copy this file to .env and replace placeholders with real values.
# Never commit actual credentials or secrets.

# PostgreSQL connection string.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to hash rate-limit identifiers with HMAC-SHA256.
# Generate with: openssl rand -hex 32
# Use the same secret across application instances sharing a database.
RATE_LIMIT_SECRET="replace-with-a-random-64-character-hex-string"
