    ],
    "execute": [
      {
        "description": "create table \"RateLimit\"",
        "sql": "CREATE TABLE \"public\".\"RateLimit\" (\n  \"attempts\" int4 DEFAULT 0 NOT NULL,\n  \"expiresAt\" timestamptz NOT NULL,\n  \"keyHash\" text NOT NULL,\n  \"policy\" text NOT NULL,\n  \"rateLimitId\" SERIAL NOT NULL,\n  \"windowStart\" timestamptz NOT NULL,\n  PRIMARY KEY (\"rateLimitId\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"RateLimit\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"RateLimit\""
        ]
      }
    ]
  },
  {
    "id": "unique.RateLimit.RateLimit_keyHash_policy_key",
    "label": "Add unique constraint on \"RateLimit\" (keyHash, policy)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
