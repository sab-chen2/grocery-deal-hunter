    "precheck": [
      {
        "description": "ensure constraint \"RateLimit_keyHash_policy_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "RateLimit_keyHash_policy_key",
          "public",
          "\"public\".\"RateLimit\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"RateLimit_keyHash_policy_key\"",
        "sql": "ALTER TABLE \"public\".\"RateLimit\" ADD CONSTRAINT \"RateLimit_keyHash_policy_key\" UNIQUE (\"keyHash\", \"policy\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"RateLimit_keyHash_policy_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
